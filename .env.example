# ===== NVIDIA NIM (REQUIRED) =====
NVIDIA_API_KEY=nvapi-REPLACE_ME
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: self-hosted NIM container (drop-in replacement)
# NVIDIA_BASE_URL=http://localhost:8000/v1

# ===== MODEL ROUTING =====
# Tier-based routing. Router picks dynamically; these are the defaults per tier.
NIM_MODEL_REASONING=nvidia/llama-3.3-nemotron-ultra-253b
NIM_MODEL_GENERAL=nvidia/llama-3.3-nemotron-super-49b
NIM_MODEL_CODE=deepseek-ai/deepseek-v4-flash
NIM_MODEL_FAST=nvidia/llama-3.3-nemotron-nano-8b
NIM_MODEL_LONG_CONTEXT=moonshotai/kimi-k2.5
NIM_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2

# ===== AUTO MODEL DISCOVERY =====
NIM_AUTO_DISCOVER=true              # merge live /v1/models into router catalog
NIM_PARALLEL_RACE=false             # race top-N models per tier; pick fastest correct

# ===== CACHE =====
CACHE_BACKEND=memory                # memory | redis
REDIS_URL=redis://localhost:6379/0
CACHE_EXACT_TTL=3600                # seconds
CACHE_SEMANTIC_TTL=7200
CACHE_SEMANTIC_THRESHOLD=0.92       # cosine similarity required for hit

# ===== VECTOR MEMORY =====
VECTOR_BACKEND=numpy                # numpy | faiss
VECTOR_DIM=1024                     # match the embedding model output
VECTOR_DB_PATH=./data/vectors.npz
SUMMARIZE_AFTER=40                  # turns; auto-summarize older chat history

# ===== SEARCH =====
SEARCH_ENABLED=true
SEARCH_BACKEND=duckduckgo           # duckduckgo (no key) | tavily | serper
TAVILY_API_KEY=
SERPER_API_KEY=
DEEP_SEARCH_MAX_STEPS=4

# ===== LEARNING =====
PASSIVE_LEARNING=true               # adjust router scores + skill weights from outcomes
LEARNING_DECAY=0.9                  # exponential decay on observations

# ===== SERVER =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ===== EXECUTION =====
DEFAULT_MODE=smart_assist          # full_auto | smart_assist | manual
ALLOW_TERMINAL=true
ALLOW_FILESYSTEM=true
ALLOW_NETWORK=true
SANDBOX_DANGEROUS=true             # wrap risky commands in sandbox
REQUIRE_CONFIRM_FOR=rm,sudo,format,dd,mkfs,shutdown,reboot

# ===== MEMORY =====
MEMORY_DB_PATH=./data/memory.db
MAX_CHAT_HISTORY=200

# ===== VOICE =====
VOICE_ENABLED=true
VOICE_LANG=mn                      # mn (Mongolian) | en
STT_PROVIDER=whisper               # whisper | vosk
TTS_PROVIDER=edge                  # edge | piper

# ===== UPGRADE =====
UPGRADE_DIR=./versions
CURRENT_VERSION=1
UPGRADE_CONFIRM_PHRASE=upgrade myself

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_DIR=./logs
